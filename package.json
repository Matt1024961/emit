{
  "name": "panel-io-configurator",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matt1024961/emit.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:all": "node scripts/check-all.mjs",
    "dev": "vite",
    "lint": "biome check .",
    "lint:a11y-tests": "node scripts/lint-a11y-tests.mjs",
    "lint:audit": "npm audit --omit=dev --audit-level=high",
    "lint:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src",
    "lint:commitlint": "commitlint --edit",
    "lint:dry": "jscpd src",
    "lint:file-length": "node scripts/lint-file-length.mjs",
    "lint:fix": "biome check --write .",
    "lint:jsdoc": "node scripts/lint-jsdoc.mjs",
    "lint:knip": "knip",
    "lint:no-ignores": "node scripts/lint-no-ignores.mjs",
    "lint:no-window-dialogs": "node scripts/lint-no-window-dialogs.mjs",
    "lint:pkg-order": "sort-package-json --check",
    "lint:spelling": "cspell --no-progress --no-must-find-files \"src/**/*.{ts,tsx}\" \"**/*.md\" \"scripts/**/*.mjs\"",
    "lint:storybook-coverage": "node scripts/lint-storybook-coverage.mjs",
    "prepare": "husky",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/happy-path.spec.ts",
    "test:ui": "vitest --ui",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "jscpd": "^4.2.4",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "madge": "^8.0.0",
    "sort-package-json": "^3.7.0",
    "storybook": "^10.4.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
